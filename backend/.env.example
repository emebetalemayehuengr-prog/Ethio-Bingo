APP_NAME=40bingo API
APP_ENV=production
FORTY_BINGO_DB_PATH=/var/data/40bingo.db
FORTY_BINGO_FALLBACK_DB_PATH=/var/data/40bingo_fallback.db
PERSISTENT_SQLITE_ROOTS=/var/data,/home
# Legacy env keys are still supported:
# ETHIO_BINGO_DB_PATH=
# ETHIO_BINGO_FALLBACK_DB_PATH=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/forty_bingo
ALLOW_EPHEMERAL_DB=false

TELEGRAM_BOT_TOKEN=__PASTE_TELEGRAM_BOT_TOKEN__
ENABLE_DEMO_SEED=false
ENABLE_SIMULATED_ACTIVITY=true
SIMULATED_SELECTING_MAX_PAID=60
SIMULATED_PLAYING_MAX_PAID=120
SIMULATED_SELECTING_STEP_SECONDS=3
SIMULATED_SELECTING_CARDS_PER_STEP=2
SIMULATED_PLAYING_CARDS_PER_CALL=1
SIMULATED_BOT_POOL_SIZE=36
SIMULATED_PHONE_START=96000000

ADMIN_BOOTSTRAP_PHONES=0900000000
ADMIN_ALERT_EMAILS=ops@example.com
WITHDRAW_ALERT_PHONES=0900000000
ADMIN_ALERT_SMS_RECIPIENTS=+251900000000
SMTP_SMS_GATEWAY_DOMAIN=sms.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=example-user
SMTP_PASSWORD=example-password
SMTP_FROM=no-reply@example.com
SMTP_USE_SSL=false
SMTP_USE_TLS=true

SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=https://40bingo.com,https://www.40bingo.com
CORS_ALLOWED_ORIGIN_REGEX=^https:\/\/(40bingo\.com|www\.40bingo\.com)$

ENABLE_INTERNAL_TRANSFER=false
TRANSFER_OTP_VERIFY_URL=https://api.example.com/v1/otp/verify
TRANSFER_OTP_VERIFY_TIMEOUT_SECONDS=6

SIGNUP_INITIAL_MAIN_BALANCE=0
SIGNUP_INITIAL_BONUS_BALANCE=0